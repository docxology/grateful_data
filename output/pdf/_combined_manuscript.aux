\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Concentration uncertainty: fixed-seed item-level bootstrap intervals for repertoire and venue concentration statistics. Data source: bundled song-performance and venue-show count vectors. Statistic: 95\% item-level bootstrap intervals for Gini and top-decile share. Exclusion rule: song rows exclude generic segment markers; venue rows use source-derived venue slugs. Claim class: exploratory uncertainty diagnostic, not a causal model.}}{16}{figure.caption.6}\protected@file@percent }
\newlabel{fig:concentration_uncertainty}{{5}{16}{Concentration uncertainty: fixed-seed item-level bootstrap intervals for repertoire and venue concentration statistics. Data source: bundled song-performance and venue-show count vectors. Statistic: 95\% item-level bootstrap intervals for Gini and top-decile share. Exclusion rule: song rows exclude generic segment markers; venue rows use source-derived venue slugs. Claim class: exploratory uncertainty diagnostic, not a causal model}{figure.caption.6}{}}
\newlabel{fig:concentration_uncertainty@cref}{{[figure][5][]5}{[1][14][]16}{}{}{}}
